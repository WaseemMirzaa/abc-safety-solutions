# ─────────────────────────────────────────────────────────────
#  ABC Safety Solutions — Production Environment
#  Copy this file to .env and fill in every CHANGE_THIS value.
#  NEVER commit the real .env to version control.
# ─────────────────────────────────────────────────────────────

# ---- MySQL -------------------------------------------------------
# Root password used by the mysql container
MYSQL_ROOT_PASSWORD=CHANGE_THIS_STRONG_ROOT_PASSWORD

# App database credentials (must match DB_* vars below)
DB_HOST=mysql
DB_PORT=3306
DB_USER=abc
DB_PASSWORD=CHANGE_THIS_STRONG_APP_PASSWORD
DB_NAME=abc_portal

# ---- Application -------------------------------------------------
NODE_ENV=production
PORT=3000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_THIS_LONG_RANDOM_SECRET_AT_LEAST_48_CHARS
JWT_EXPIRES_IN=7d

# Directory inside the container where uploads are stored
UPLOAD_DIR=./uploads

# Public-facing base URL of this server (no trailing slash).
# Used to build /uploads/* URLs returned by the image upload endpoint.
# Example: http://165.22.100.50  or  https://training.yourcompany.com
PUBLIC_BASE_URL=http://2.24.110.154

# ---- CORS --------------------------------------------------------
# Comma-separated list of allowed frontend origins.
# If frontend and backend are on the same domain (served via nginx), use that domain.
FRONTEND_URL=http://2.24.110.154

# ---- Stripe (course purchases) ----------------------------------
# See docs/STRIPE_SETUP.md. Test keys from Stripe Dashboard → Developers → API keys.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# Frontend build (Vite): set VITE_STRIPE_ENABLED=true when deploying paid checkout.
# Frontend: VITE_DEBUG_LOGS=true prints API errors to the browser console in production builds.
# WebSocket notifications use the API origin (VITE_API_URL) + /notifications namespace.

# ---- OpenAI (AI slide captions + narration audio) -----------------
# Required to auto-generate per-slide captions/audio when a course PDF/PPTX is
# rendered to images. Leave blank to disable — courses still work, slides just
# have no AI captions/audio (admin can still type captions manually once added).
OPENAI_API_KEY=sk-CHANGE_ME
# Vision + structured-output model used to caption each rendered slide image.
OPENAI_VISION_MODEL=gpt-4o-mini
# Text-to-speech model + voice used to narrate each slide's caption.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
# Comma-separated language codes to generate captions/audio for. Must match
# frontend/src/i18n/config.ts supportedLngs (currently en,es — NOT fr).
NARRATION_LANGUAGES=en,es
# Max OpenAI narration calls (vision caption + TTS) in flight across the WHOLE server at
# once — the single real throughput knob (a course's own page-dispatch pool auto-scales
# above this, so raising it here is what actually speeds up generation). Conservative
# default; raise once you've watched a real run and confirmed your OpenAI account tier
# isn't getting 429'd (check API logs for "retry" warnings from describeSlideImage /
# synthesizeSpeech — frequent retries mean you've gone above your account's real limit).
# Rough guide for a ~150-slide PDF, both EN+ES: concurrency 4 ≈ 4-6 min, 10 ≈ 2-3 min,
# 20 ≈ 1-2 min — actual time depends on your OpenAI tier's rate limits and image sizes.
NARRATION_CONCURRENCY=4

# ---- FCM (optional — Android/iOS WebView; service account JSON fields) ----
# Create in Firebase Console → Project settings → Service accounts → Generate key.
# FCM_PROJECT_ID=your-project-id
# FCM_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#
# After deploy: bash scripts/run-db-migrations.sh
# Re-save courses in admin so PDFs convert (requires poppler in API container).

# ---- Admin user (used by npm run admin:create) -------------------
# ADMIN_EMAIL=admin@yourcompany.com
# ADMIN_NAME=Admin
# ADMIN_PASSWORD=ChangeThisStrongPassword123!
